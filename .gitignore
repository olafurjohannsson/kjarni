target/
.idea/
Cargo.lock
*.safetensors
vocab.txt
# Not a blanket *.json: that silently swallowed every package.json and
# tsconfig.json in the repo, so the TypeScript package could not be committed and
# its publish job had nothing to build. Ignore the generated ones by path instead.
**/obj/*.json
**/bin/*.json

# Personal editor and tool state, previously hidden by the blanket *.json.
.claude/settings.local.json
.vscode/
pkg/
bin/
obj/
*.pyc
node_modules/
.test-venv/
.test-logs/

# Local Python wheel builds. The native library is copied in by CI at publish
# time; a copy left here by a local `python -m build` must never be committed.
crates/kjarni-ffi/bindings/python/kjarni/*.so
crates/kjarni-ffi/bindings/python/kjarni/*.dylib
crates/kjarni-ffi/bindings/python/kjarni/*.dll
crates/kjarni-ffi/bindings/python/build/
crates/kjarni-ffi/bindings/python/dist/
crates/kjarni-ffi/bindings/python/*.egg-info/
