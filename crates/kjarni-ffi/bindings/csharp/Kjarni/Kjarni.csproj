<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.1 is for Unity, which cannot load net8.0 assemblies. -->
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- Ships Kjarni.xml in the package, so IDEs show the doc comments. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package metadata -->
    <PackageId>Kjarni</PackageId>
    <Version>0.4.0</Version>
    <Authors>Ólafur Aron Jóhannsson</Authors>
    <Description>Run transformer models inside your .NET program: embeddings, classification, reranking, search, chat, speech-to-text, summarization and translation. Same output as PyTorch. No Python runtime, no ONNX Runtime, no Ollama daemon, no CUDA toolkit. GPU support runs on Vulkan, DirectX 12 and Metal, so AMD, Intel and Apple Silicon work without NVIDIA.</Description>
    <PackageTags>ai;ml;embeddings;classification;reranking;rag;search;nlp;inference;transformers;local;offline;dotnet;csharp;onnx;sentence-transformers;semantic-kernel;microsoft-extensions-ai;gpu;webgpu</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/olafurjohannsson/kjarni</PackageProjectUrl>
    <RepositoryUrl>https://github.com/olafurjohannsson/kjarni</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright © 2025 Ólafur Aron Jóhannsson</Copyright>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- No package dependencies on any target: Unity cannot restore them, so the
       netstandard2.1 build has to be two files, Kjarni.dll and the native library. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Kjarni.Tests" />
  </ItemGroup>

  <!-- README and icon -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" Condition="Exists('icon.png')" />
  </ItemGroup>

  <!-- Native libraries per platform (for NuGet package) -->
  <ItemGroup>
    <None Include="runtimes/linux-x64/native/**" Pack="true" PackagePath="runtimes/linux-x64/native" />
    <None Include="runtimes/linux-arm64/native/**" Pack="true" PackagePath="runtimes/linux-arm64/native" />
    <None Include="runtimes/win-x64/native/**" Pack="true" PackagePath="runtimes/win-x64/native" />
    <None Include="runtimes/osx-x64/native/**" Pack="true" PackagePath="runtimes/osx-x64/native" />
    <None Include="runtimes/osx-arm64/native/**" Pack="true" PackagePath="runtimes/osx-arm64/native" />
  </ItemGroup>

  <!-- Local dev / CI: copy native lib to output for dotnet run/test.
       Defaults to the workspace target dir, five levels up from this file.
       Override with -p:NativeLibraryPath=... for cross-compiled output. -->
  <PropertyGroup>
    <NativeLibraryPath Condition="'$(NativeLibraryPath)' == ''">$(MSBuildThisFileDirectory)../../../../../target/release</NativeLibraryPath>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('$(NativeLibraryPath)/libkjarni_ffi.so')">
    <None Include="$(NativeLibraryPath)/libkjarni_ffi.so"
          CopyToOutputDirectory="PreserveNewest"
          Link="libkjarni_ffi.so"
          Pack="false" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(NativeLibraryPath)/libkjarni_ffi.dylib')">
    <None Include="$(NativeLibraryPath)/libkjarni_ffi.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Link="libkjarni_ffi.dylib"
          Pack="false" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('$(NativeLibraryPath)/kjarni_ffi.dll')">
    <None Include="$(NativeLibraryPath)/kjarni_ffi.dll"
          CopyToOutputDirectory="PreserveNewest"
          Link="kjarni_ffi.dll"
          Pack="false" />
  </ItemGroup>
</Project>