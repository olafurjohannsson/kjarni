{
  "name": "kjarni-wasm",
  "version": "0.3.0",
  "description": "Run transformer models inside your web page: embeddings, classification, reranking, semantic search and chat in a Web Worker. Same output as PyTorch, no server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "pkg"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "rm -rf pkg && cp -r ../pkg pkg && rm -f pkg/.gitignore",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olafurjohannsson/kjarni.git",
    "directory": "crates/kjarni-wasm"
  },
  "homepage": "https://kjarni.ai",
  "keywords": [
    "ai",
    "embeddings",
    "webassembly",
    "wasm",
    "local",
    "offline",
    "bert",
    "rag",
    "semantic-search",
    "web-worker"
  ]
}
